{
  "id": "own-server",
  "name": "Tu servidor",
  "version": "1.1.0",
  "apiVersion": 2,
  "entry": "plugin.js",
  "description": "Ve el contenido de tu propio servidor de video. Necesita que escribas su dirección.",
  "author": "kinotvapp",
  "homepage": "https://github.com/kinotvapp/kino-plugin-own-server",
  "hosts": [
    "example.org"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download"
  ],
  "settings": [
    { "key": "server", "label": "Servidor", "type": "url", "required": true, "hint": "http://192.168.1.10:8096" },
    { "key": "user", "label": "Usuario", "type": "text", "required": true },
    { "key": "password", "label": "Contraseña", "type": "password", "required": true },
    { "key": "hd", "label": "Solo HD", "type": "toggle" }
  ],
  "color": "#1F8A70",
  "icon": "icon.png"
}
